# Deployed as <webroot>/api/: every /api/* request goes to index.php
Options -Indexes

# never serve the .env (secrets) or any other dotfile
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On
# required on IONOS: without it the relative target resolves to a wrong path (404)
RewriteBase /api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
